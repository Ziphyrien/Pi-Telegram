{
  "name": "pi-telegram",
  "version": "0.5.0",
  "description": "Pi-Telegram: Bridge Telegram bots to pi coding agent via RPC",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test --isolate",
    "ready": "bun run build && bun run test",
    "start": "bun dist/main.js",
    "dev": "bun --watch src/main.ts",
    "pitg": "bun dist/main.js",
    "release": "bun scripts/release.mjs",
    "prepublishOnly": "bun run build"
  },
  "bin": {
    "pitg": "dist/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@grammyjs/auto-chat-action": "^0.1.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/commands": "^1.4.0",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/hydrate": "^1.7.0",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/runner": "^2.0.3",
    "croner": "^10.0.1",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@grammyjs/types": "^4.0.0",
    "@types/node": "^26.2.0",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "pi",
    "pi-coding-agent",
    "grammy",
    "rpc",
    "ai-agent",
    "cli"
  ]
}
